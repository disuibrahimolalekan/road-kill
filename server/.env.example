# Copy to .env (never commit .env). On Render, set these in Dashboard → Environment.
# Local default port when PORT is unset.
PORT=8130
# Gate the admin API (/api/banners/*, /api/config/*). Leave empty = open (local only).
ADMIN_KEY=
# Postgres connection string (Supabase / Neon / Render Postgres). Empty = db.json file mode.
DATABASE_URL=
